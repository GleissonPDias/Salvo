<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#2A303C"
    app:cardCornerRadius="16dp"
    app:strokeWidth="0dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <FrameLayout
            android:id="@+id/fl_icon_bg"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_icon">

            <ImageView
                android:id="@+id/iv_servico_icone"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_directions"
                app:tint="#9E9E9E" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/fl_icon_bg"
            android:layout_toStartOf="@+id/ll_price_time"
            android:layout_centerVertical="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_cliente_nome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carlos Silva"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_servico_distancia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Guincho • 2.5km"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_localizacao"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📍 Carregando endereço..."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="4dp"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tv_veiculo_designado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🚛 Veículo..."
                android:textColor="#94A3B8"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ll_price_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_servico_valor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 120"
                android:textColor="#FF9800"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_servico_hora"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="14:30"
                android:textColor="#9E9E9E"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tv_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Status"
                android:textColor="#4CAF50"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="6dp" />
        </LinearLayout>

    </RelativeLayout>
</com.google.android.material.card.MaterialCardView>