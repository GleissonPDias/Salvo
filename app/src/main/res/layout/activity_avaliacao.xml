<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E232D"
    android:padding="24dp">

    <ImageView
        android:id="@+id/iv_check_sucesso"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_marginTop="40dp"
        android:src="@android:drawable/checkbox_on_background"
        app:tint="#4CAF50"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/tv_obrigado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Serviço Concluído!"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/iv_check_sucesso" />

    <TextView
        android:id="@+id/tv_pergunta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Como foi sua experiência com a oficina?"
        android:textAlignment="center"
        android:textColor="#9E9E9E"
        android:textSize="16sp"
        app:layout_constraintTop_toBottomOf="@id/tv_obrigado" />

    <RatingBar
        android:id="@+id/rating_bar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:numStars="5"
        android:stepSize="1.0"
        android:progressTint="#F39C12"
        android:secondaryProgressTint="#F39C12"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tv_pergunta" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/til_comentario"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:boxBackgroundColor="#2A303C"
        app:boxCornerRadiusTopStart="12dp"
        app:boxCornerRadiusTopEnd="12dp"
        app:boxCornerRadiusBottomStart="12dp"
        app:boxCornerRadiusBottomEnd="12dp"
        app:hintTextColor="#FF9800"
        android:textColorHint="#9E9E9E"
        app:boxStrokeColor="#FF9800"
        app:layout_constraintTop_toBottomOf="@id/rating_bar">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/et_comentario_avaliacao"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:gravity="top"
            android:hint="Deixe um comentário (opcional)"
            android:textColor="#FFFFFF"
            android:inputType="textMultiLine" />
    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_enviar_avaliacao"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginBottom="16dp"
        android:text="ENVIAR AVALIAÇÃO"
        android:textColor="#1E232D"
        android:textStyle="bold"
        app:backgroundTint="#FF9800"
        app:cornerRadius="12dp"
        app:layout_constraintBottom_toBottomOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>