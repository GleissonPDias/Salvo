<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp"
    android:id="@+id/main"
    app:cardBackgroundColor="@color/salvo_card_fundo"
    app:cardCornerRadius="16dp"
    app:strokeColor="@color/salvo_linha_divisoria"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/iv_icone_servico"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:padding="12dp"
            android:src="@drawable/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/salvo_azul_neon" />

        <TextView
            android:id="@+id/tv_nome_servico"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:text="S.O.S. Borracharia"
            android:textColor="@color/salvo_texto_principal"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_status_pedido"
            app:layout_constraintStart_toEndOf="@id/iv_icone_servico"
            app:layout_constraintTop_toTopOf="@id/iv_icone_servico" />

        <TextView
            android:id="@+id/tv_status_pedido"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Concluído"
            android:textColor="@color/salvo_laranja"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/tv_nome_servico" />

        <TextView
            android:id="@+id/tv_data_hora"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="12 Mai 2026 • 14:30"
            android:textColor="@color/salvo_texto_secundario"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="@+id/tv_nome_servico"
            app:layout_constraintStart_toStartOf="@id/tv_nome_servico"
            app:layout_constraintTop_toBottomOf="@id/tv_nome_servico" />

        <View
            android:id="@+id/linha_separadora"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/salvo_linha_divisoria"
            app:layout_constraintTop_toBottomOf="@id/iv_icone_servico" />

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/iv_foto_prestador"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:scaleType="centerCrop"
            app:cornerSize="8dp"
            android:src="@drawable/logo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/linha_separadora" />

        <TextView
            android:id="@+id/tv_nome_prestador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Carlos Borracharia"
            android:textColor="@color/salvo_texto_principal"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/tv_preco"
            app:layout_constraintStart_toEndOf="@id/iv_foto_prestador"
            app:layout_constraintTop_toTopOf="@id/iv_foto_prestador" />

        <TextView
            android:id="@+id/tv_veiculo_prestador"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Guincho Plataforma • ABC-1234"
            android:textColor="@color/salvo_texto_secundario"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="@id/tv_nome_prestador"
            app:layout_constraintEnd_toStartOf="@+id/tv_preco"
            app:layout_constraintTop_toBottomOf="@id/tv_nome_prestador" />

        <TextView
            android:id="@+id/tv_preco"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 45,00"
            android:textColor="@color/salvo_texto_principal"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="@id/iv_foto_prestador"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/iv_foto_prestador" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_acao_pedido"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Pedir Novamente"
            android:textSize="16sp"
            android:textColor="@color/salvo_azul_neon"
            app:strokeColor="@color/salvo_azul_neon"
            app:layout_constraintTop_toBottomOf="@id/iv_foto_prestador" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>