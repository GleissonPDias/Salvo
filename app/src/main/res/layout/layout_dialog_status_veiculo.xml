<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E232D"
    android:orientation="vertical"
    android:padding="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="24dp"
        android:background="#4A5568" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:text="Alterar Status Operacional"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:textStyle="bold" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_status_disponivel"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="DISPONÍVEL"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#10B981"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_status_atendimento"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="12dp"
        android:text="EM ATENDIMENTO"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#F59E0B"
        app:cornerRadius="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_status_manutencao"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="INDISPONÍVEL / MANUTENÇÃO"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:backgroundTint="#EF4444"
        app:cornerRadius="8dp" />

</LinearLayout>